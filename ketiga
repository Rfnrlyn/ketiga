import React, { useState, useEffect, useRef } from 'react';
import { 
  Zap, 
  Battery, 
  Wind, 
  Sun, 
  ArrowRight, 
  RotateCcw, 
  CheckCircle2, 
  Play,
  Lightbulb,
  TreeDeciduous,
  Trophy,
  BookOpen,
  Volume2,
  VolumeX,
  FastForward,
  Power
} from 'lucide-react';

const App = () => {
  // 'start' sebagai view awal untuk memicu interaksi user agar audio bisa diputar
  const [view, setView] = useState('start'); 
  const [currentLesson, setCurrentLesson] = useState(0);
  const [score, setScore] = useState(0);
  const [isMuted, setIsMuted] = useState(false);
  const [hasStarted, setHasStarted] = useState(false);
  
  // Physics Lab State
  const [height, setHeight] = useState(10);
  const [mass, setMass] = useState(2);
  const [velocity, setVelocity] = useState(0);
  const [isAnimating, setIsAnimating] = useState(false);
  const [labResult, setLabResult] = useState({ ep: 200, ek: 0, em: 200 });

  // Audio Control
  const audioRef = useRef(null);
  
  // Menggunakan direct link raw dari GitHub
  const musicUrl = "https://github.com/Rfnrlyn/Musik-Latar-Game-energi/raw/refs/heads/main/Solve_for_X.mp3"; 

  const handleStartGame = () => {
    setHasStarted(true);
    setView('menu');
    if (audioRef.current) {
      audioRef.current.play().catch(e => console.log("Audio play blocked", e));
    }
  };

  const toggleMute = () => {
    const newMuteState = !isMuted;
    setIsMuted(newMuteState);
    if (audioRef.current) {
      audioRef.current.muted = newMuteState;
    }
  };

  const lessons = [
    {
      title: "Konsep Usaha (W)",
      content: "Usaha dalam fisika didefinisikan sebagai hasil kali gaya (F) dengan perpindahan (s) yang searah dengan gaya tersebut.",
      formula: "W = F × s",
      unit: "Joule (J)",
      fact: "Jika gaya diberikan tapi benda tidak berpindah, maka Usaha = 0!"
    },
    {
      title: "Energi Kinetik & Potensial",
      content: "Energi Kinetik (Ek) adalah energi karena gerak. Energi Potensial (Ep) adalah energi karena posisi atau ketinggian.",
      formula: "Ek = ½mv² | Ep = mgh",
      unit: "Joule (J)",
      fact: "Energi Potensial akan maksimal saat benda berada di titik tertinggi."
    },
    {
      title: "Hukum Kekekalan Energi",
      content: "Energi tidak hilang, ia hanya berubah bentuk. Total Energi Mekanik (Ep + Ek) dalam sistem terisolasi selalu tetap.",
      formula: "Em1 = Em2",
      unit: "Joule (J)",
      fact: "Pada benda jatuh bebas, pengurangan Ep selalu sama dengan penambahan Ek."
    }
  ];

  const quizData = [
    {
      question: "Benda bermassa 4kg di ketinggian 10m (g=10). Berapa energi potensialnya?",
      options: ["40 J", "100 J", "400 J", "4000 J"],
      correct: 2
    },
    {
      question: "Apa yang terjadi pada energi kinetik jika kecepatan benda menjadi dua kali lipat?",
      options: ["Tetap sama", "Menjadi 2x lipat", "Menjadi 4x lipat", "Menjadi nol"],
      correct: 2
    },
    {
      question: "Manakah yang merupakan sumber energi terbarukan yang ramah lingkungan?",
      options: ["Gas Alam", "Minyak Bumi", "Panel Surya", "Batubara"],
      correct: 2
    }
  ];

  const [currentQuiz, setCurrentQuiz] = useState(0);

  useEffect(() => {
    const g = 10;
    const ep = mass * g * height;
    const ek = 0.5 * mass * Math.pow(velocity, 2);
    setLabResult({ ep, ek, em: ep + ek });
  }, [height, mass, velocity]);

  const handleRunSimulation = () => {
    setIsAnimating(true);
    let currentH = height;
    let currentV = velocity;
    const g = 10;
    const dt = 0.05;

    const timer = setInterval(() => {
      if (currentH <= 0) {
        clearInterval(timer);
        setIsAnimating(false);
        return;
      }
      currentV += g * dt;
      currentH -= (currentV * dt);
      if (currentH < 0) currentH = 0;
      
      setHeight(currentH);
      setVelocity(currentV);
    }, 50);
  };

  const resetSimulation = () => {
    setHeight(10);
    setVelocity(0);
    setIsAnimating(false);
  };

  const renderContent = () => {
    if (view === 'start') {
      return (
        <div className="flex flex-col items-center justify-center p-12 bg-white rounded-3xl shadow-2xl animate-in zoom-in duration-700 max-w-lg w-full border-4 border-blue-500">
          <div className="w-24 h-24 bg-blue-600 rounded-full flex items-center justify-center mb-6 animate-pulse shadow-xl shadow-blue-200">
            <Power className="w-12 h-12 text-white" />
          </div>
          <h1 className="text-4xl font-black text-gray-800 mb-2">Energi-Quest</h1>
          <p className="text-gray-500 mb-8 text-center">Siap mempelajari rahasia semesta melalui Usaha dan Energi?</p>
          <button 
            onClick={handleStartGame}
            className="group relative flex items-center justify-center px-12 py-4 bg-blue-600 text-white rounded-2xl font-bold text-xl hover:bg-blue-700 transition-all shadow-lg hover:shadow-blue-300"
          >
            <Play className="mr-2 w-6 h-6 fill-current" /> MULAI PETUALANGAN
          </button>
          <p className="mt-6 text-xs text-gray-400 font-medium">Klik untuk mengaktifkan musik latar</p>
        </div>
      );
    }

    switch(view) {
      case 'menu':
        return (
          <div className="flex flex-col items-center space-y-8 animate-in fade-in duration-500 w-full max-w-4xl">
            <div className="text-center">
              <h1 className="text-4xl font-bold text-gray-800 tracking-tight">Main Menu</h1>
              <p className="text-gray-500">Pilih modul untuk memulai tantangan</p>
            </div>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 w-full px-4">
              <button onClick={() => setView('lesson')} className="group flex items-center p-8 bg-white border-2 border-transparent hover:border-blue-500 rounded-3xl shadow-lg transition-all active:scale-95">
                <div className="bg-blue-100 p-4 rounded-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors"><BookOpen className="w-8 h-8" /></div>
                <div className="ml-6 text-left"><h3 className="text-xl font-bold text-gray-800">Modul Materi</h3><p className="text-gray-500">Usaha & Energi Mekanik</p></div>
              </button>
              <button onClick={() => setView('lab')} className="group flex items-center p-8 bg-white border-2 border-transparent hover:border-green-500 rounded-3xl shadow-lg transition-all active:scale-95">
                <div className="bg-green-100 p-4 rounded-2xl group-hover:bg-green-600 group-hover:text-white transition-colors"><RotateCcw className="w-8 h-8" /></div>
                <div className="ml-6 text-left"><h3 className="text-xl font-bold text-gray-800">Laboratorium</h3><p className="text-gray-500">Eksperimen Benda Jatuh</p></div>
              </button>
              <button onClick={() => setView('quest')} className="group flex items-center p-8 bg-white border-2 border-transparent hover:border-yellow-500 rounded-3xl shadow-lg transition-all active:scale-95">
                <div className="bg-yellow-100 p-4 rounded-2xl group-hover:bg-yellow-600 group-hover:text-white transition-colors"><Sun className="w-8 h-8" /></div>
                <div className="ml-6 text-left"><h3 className="text-xl font-bold text-gray-800">Misi Lingkungan</h3><p className="text-gray-500">Energi Masa Depan</p></div>
              </button>
              <button onClick={() => setView('quiz')} className="group flex items-center p-8 bg-white border-2 border-transparent hover:border-purple-500 rounded-3xl shadow-lg transition-all active:scale-95">
                <div className="bg-purple-100 p-4 rounded-2xl group-hover:bg-purple-600 group-hover:text-white transition-colors"><Trophy className="w-8 h-8" /></div>
                <div className="ml-6 text-left"><h3 className="text-xl font-bold text-gray-800">Ujian Akhir</h3><p className="text-gray-500">Kumpulkan Skor Tertinggi</p></div>
              </button>
            </div>
          </div>
        );

      case 'lesson':
        const lesson = lessons[currentLesson];
        return (
          <div className="w-full max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden animate-in slide-in-from-right duration-500">
            <div className="bg-blue-600 p-8 text-white flex justify-between items-center">
              <h2 className="text-2xl font-bold">{lesson.title}</h2>
              <span className="bg-blue-800 px-4 py-1 rounded-full text-sm font-mono tracking-widest">STEP {currentLesson + 1}/3</span>
            </div>
            <div className="p-10">
              <p className="text-xl text-gray-700 leading-relaxed mb-8">{lesson.content}</p>
              <div className="bg-blue-50 p-8 rounded-3xl border-2 border-blue-100 mb-8 text-center shadow-inner">
                <p className="text-xs text-blue-600 font-black uppercase tracking-widest mb-3">Formula Rahasia</p>
                <h4 className="text-4xl font-mono font-black text-blue-900 tracking-tighter">{lesson.formula}</h4>
              </div>
              <div className="flex items-start bg-yellow-50 p-5 rounded-2xl mb-10 border border-yellow-100">
                <Lightbulb className="w-6 h-6 text-yellow-600 mr-4 mt-1 flex-shrink-0" />
                <p className="text-sm text-yellow-800 italic"><span className="font-bold not-italic">Tahukah kamu?</span> {lesson.fact}</p>
              </div>
              <div className="flex justify-between">
                <button onClick={() => currentLesson === 0 ? setView('menu') : setCurrentLesson(prev => prev - 1)} className="px-8 py-3 border-2 border-gray-100 rounded-2xl hover:bg-gray-50 font-bold transition-all text-gray-600">Kembali</button>
                <button onClick={() => currentLesson < lessons.length - 1 ? setCurrentLesson(prev => prev + 1) : setView('lab')} className="px-10 py-3 bg-blue-600 text-white rounded-2xl font-bold shadow-lg shadow-blue-200 flex items-center hover:bg-blue-700 transition-all">Lanjut <ArrowRight className="ml-2 w-5 h-5" /></button>
              </div>
            </div>
          </div>
        );

      case 'lab':
        return (
          <div className="w-full max-w-5xl bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col lg:flex-row animate-in zoom-in duration-300">
            <div className="lg:w-3/5 bg-slate-900 relative h-96 lg:h-auto flex items-end justify-center p-10 border-b lg:border-b-0 lg:border-r border-gray-800">
              <div className="absolute top-6 left-6 text-gray-500 font-mono text-xs flex items-center uppercase tracking-widest">
                <div className="w-2 h-2 bg-red-500 rounded-full mr-2 animate-pulse"></div> Live Simulation
              </div>
              <div className="absolute bottom-0 w-full h-8 bg-gradient-to-t from-emerald-900 to-transparent"></div>
              {/* Scale marks */}
              {[...Array(6)].map((_, i) => (
                <div key={i} className="absolute left-4 w-4 border-t border-gray-700" style={{ bottom: `${(i * 3 * 20) + 32}px` }}>
                  <span className="absolute left-6 -top-2 text-[10px] text-gray-500 font-mono">{i * 3}m</span>
                </div>
              ))}
              {/* Ball */}
              <div 
                className="absolute w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center shadow-[0_0_40px_rgba(37,99,235,0.4)] border-4 border-blue-400 transition-all duration-75"
                style={{ bottom: `${(height * 20) + 32}px` }}
              >
                <Zap className="text-white w-8 h-8 fill-current" />
              </div>
            </div>
            <div className="lg:w-2/5 p-10 space-y-8 bg-gray-50">
              <div>
                <h2 className="text-3xl font-black text-gray-800">Lab Virtual</h2>
                <p className="text-gray-500">Uji Konversi Energi Mekanik</p>
              </div>
              
              <div className="space-y-6">
                <div className="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                  <label className="flex justify-between text-sm font-bold text-gray-600 mb-4 uppercase tracking-tighter">
                    Ketinggian (h): <span className="text-blue-600 font-mono text-lg">{height.toFixed(1)} m</span>
                  </label>
                  <input type="range" min="0" max="15" step="0.1" value={height} onChange={(e) => !isAnimating && setHeight(parseFloat(e.target.value))} className="w-full h-3 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                </div>
                
                <div className="grid grid-cols-3 gap-3">
                  <div className="bg-blue-600 p-4 rounded-2xl text-center shadow-md">
                    <p className="text-[10px] text-blue-200 font-bold uppercase">Ep (Pot)</p>
                    <p className="text-xl font-black text-white">{labResult.ep.toFixed(0)}</p>
                  </div>
                  <div className="bg-green-600 p-4 rounded-2xl text-center shadow-md">
                    <p className="text-[10px] text-green-200 font-bold uppercase">Ek (Kin)</p>
                    <p className="text-xl font-black text-white">{labResult.ek.toFixed(0)}</p>
                  </div>
                  <div className="bg-gray-800 p-4 rounded-2xl text-center shadow-md">
                    <p className="text-[10px] text-gray-400 font-bold uppercase">Em (Tot)</p>
                    <p className="text-xl font-black text-white">{labResult.em.toFixed(0)}</p>
                  </div>
                </div>
              </div>

              <div className="flex space-x-4">
                <button onClick={handleRunSimulation} disabled={isAnimating || height === 0} className="flex-1 py-4 bg-green-600 text-white rounded-2xl font-black text-lg hover:bg-green-700 disabled:opacity-50 transition-all flex justify-center items-center shadow-xl shadow-green-100">
                  <Play className="w-6 h-6 mr-2 fill-current" /> LEPAS!
                </button>
                <button onClick={resetSimulation} className="p-4 bg-white text-gray-400 border border-gray-200 rounded-2xl hover:text-gray-800 transition-all"><RotateCcw className="w-6 h-6" /></button>
              </div>
              <button onClick={() => setView('quest')} className="w-full py-4 text-blue-600 font-bold border-2 border-dashed border-blue-200 rounded-2xl hover:bg-blue-50 transition-colors">Lanjut ke Misi →</button>
            </div>
          </div>
        );

      case 'quest':
        return (
          <div className="w-full max-w-3xl bg-white rounded-3xl shadow-2xl p-12 animate-in slide-up-4">
            <div className="flex items-center space-x-6 mb-10">
              <div className="bg-emerald-100 p-5 rounded-3xl text-emerald-600"><TreeDeciduous className="w-12 h-12" /></div>
              <div><h2 className="text-4xl font-black text-gray-800">Pahlawan Energi</h2><p className="text-gray-500 font-medium">Lestarikan bumi dengan energi terbarukan</p></div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
              <div className="group p-8 bg-gradient-to-br from-green-50 to-emerald-50 rounded-3xl border border-green-100 hover:shadow-xl transition-all">
                <Sun className="w-10 h-10 text-yellow-500 mb-4" />
                <h3 className="text-xl font-bold text-green-900 mb-2">Energi Terbarukan</h3>
                <p className="text-sm text-green-700 leading-relaxed">Gunakan sumber dari alam seperti matahari, angin, dan air yang tidak akan pernah habis.</p>
              </div>
              <div className="group p-8 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-3xl border border-blue-100 hover:shadow-xl transition-all">
                <Battery className="w-10 h-10 text-blue-500 mb-4" />
                <h3 className="text-xl font-bold text-blue-900 mb-2">Hemat Konsumsi</h3>
                <p className="text-sm text-blue-700 leading-relaxed">Kurangi pemborosan listrik di rumah. Cabut kabel yang tidak terpakai sekarang!</p>
              </div>
            </div>
            <button onClick={() => setView('quiz')} className="group w-full py-5 bg-gray-900 text-white font-black text-xl rounded-3xl hover:bg-black transition-all flex items-center justify-center shadow-2xl shadow-gray-300">
              MULAI UJIAN AKHIR <FastForward className="ml-3 w-6 h-6 group-hover:translate-x-2 transition-transform" />
            </button>
          </div>
        );

      case 'quiz':
        const q = quizData[currentQuiz];
        return (
          <div className="w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-12 animate-in slide-in-from-bottom duration-500 border-b-8 border-purple-600">
            <div className="flex justify-between items-center mb-10">
              <span className="text-xs font-black text-purple-600 bg-purple-50 px-4 py-2 rounded-xl uppercase tracking-widest">Final Challenge</span>
              <span className="text-lg font-mono text-gray-300">Question {currentQuiz + 1}/{quizData.length}</span>
            </div>
            <h2 className="text-2xl font-bold text-gray-800 mb-10 leading-snug">{q.question}</h2>
            <div className="space-y-4">
              {q.options.map((opt, idx) => (
                <button key={idx} onClick={() => {
                  if (idx === q.correct) setScore(s => s + 1);
                  if (currentQuiz < quizData.length - 1) setCurrentQuiz(prev => prev + 1);
                  else setView('result');
                }} className="w-full p-5 text-left border-2 border-gray-100 rounded-2xl hover:border-purple-500 hover:bg-purple-50 transition-all flex items-center group font-bold text-gray-700">
                  <div className="w-10 h-10 rounded-xl bg-gray-100 group-hover:bg-purple-200 text-gray-400 group-hover:text-purple-600 flex items-center justify-center mr-5 transition-colors">{String.fromCharCode(65 + idx)}</div>
                  {opt}
                </button>
              ))}
            </div>
          </div>
        );

      case 'result':
        const finalScore = Math.round((score/quizData.length)*100);
        return (
          <div className="text-center bg-white p-16 rounded-3xl shadow-2xl max-w-lg w-full animate-in zoom-in duration-500 border-4 border-yellow-400">
            <div className="relative inline-block mb-8">
              <Trophy className="w-24 h-24 text-yellow-500 mx-auto drop-shadow-lg" />
              <div className="absolute top-0 right-0 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full animate-bounce">Selesai!</div>
            </div>
            <h2 className="text-4xl font-black text-gray-800 mb-2">Selamat, Juara!</h2>
            <p className="text-gray-500 mb-10">Kamu telah membuktikan pemahamanmu tentang energi.</p>
            <div className="bg-gray-50 rounded-3xl p-10 mb-10 border-2 border-gray-100">
              <p className="text-xs font-black text-gray-400 uppercase tracking-widest mb-2">Total Akurasi</p>
              <h3 className="text-7xl font-black text-blue-600">{finalScore}%</h3>
              <div className="flex justify-center mt-6 space-x-1">
                {[...Array(3)].map((_, i) => (
                  <Zap key={i} className={`w-8 h-8 ${i < score ? 'text-yellow-500 fill-yellow-500' : 'text-gray-200'}`} />
                ))}
              </div>
            </div>
            <button onClick={() => { setView('menu'); setScore(0); setCurrentQuiz(0); setCurrentLesson(0); }} className="w-full py-5 bg-gray-900 text-white rounded-2xl font-black text-xl hover:bg-black transition-all flex items-center justify-center shadow-xl">
              <RotateCcw className="w-6 h-6 mr-3" /> MAIN LAGI
            </button>
          </div>
        );

      default: return null;
    }
  };

  return (
    <div className="min-h-screen bg-[#f8fafc] font-sans flex flex-col items-center justify-center p-6 relative overflow-hidden">
      {/* Background elements */}
      <div className="absolute top-0 left-0 w-full h-full pointer-events-none opacity-[0.03] z-0">
        <div className="absolute top-[-10%] left-[-10%] w-full h-full border-[100px] border-blue-900 rounded-full"></div>
      </div>

      {/* Audio Element */}
      <audio ref={audioRef} loop>
        <source src={musicUrl} type="audio/mpeg" />
      </audio>

      {/* Floating Audio Control (Hanya tampil jika sudah mulai) */}
      {hasStarted && (
        <div className="fixed top-8 right-8 z-50">
          <button 
            onClick={toggleMute}
            className="p-4 bg-white shadow-2xl rounded-3xl hover:scale-110 transition-transform flex items-center justify-center border border-gray-100 group"
          >
            {isMuted ? <VolumeX className="w-8 h-8 text-red-500" /> : <Volume2 className="w-8 h-8 text-blue-600 animate-pulse" />}
            <span className="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-300 ml-0 group-hover:ml-2 text-sm font-bold text-gray-500 uppercase">
              {isMuted ? "Unmute" : "Mute"}
            </span>
          </button>
        </div>
      )}

      <main className="z-10 w-full flex justify-center">
        {renderContent()}
      </main>

      <footer className="mt-12 text-center text-gray-400 text-sm font-medium z-10">
        <p>© 2024 Energi-Quest • Media Pembelajaran Kelas X Fisika</p>
      </footer>
    </div>
  );
};

export default App;
